# =====================================================================
# Solana Intelligence Bot — environment configuration
# Copy to .env and fill in the REQUIRED values. Never commit .env.
# =====================================================================

# ---------- Runtime ----------
NODE_ENV=development            # development | production | test
LOG_LEVEL=info                  # debug | info | warn | error

# ---------- Telegram (REQUIRED) ----------
# Create a bot with @BotFather and paste the token it gives you.
TELEGRAM_BOT_TOKEN=123456789:replace-with-your-botfather-token

# ---------- Helius (REQUIRED) ----------
# Free key: https://dashboard.helius.dev → API Keys
HELIUS_API_KEY=replace-with-your-helius-api-key
# REST base for Parsed Events + Webhooks APIs (default is correct for mainnet)
HELIUS_API_BASE=https://mainnet.helius-rpc.com
# Optional: override the RPC URL (defaults to https://mainnet.helius-rpc.com/?api-key=HELIUS_API_KEY)
HELIUS_RPC_URL=
# Fallback RPC used only when Helius RPC fails (public, heavily rate limited)
SOLANA_FALLBACK_RPC_URL=https://api.mainnet-beta.solana.com

# ---------- Supabase (REQUIRED) ----------
# Project Settings → API. Use the service_role key (server-side only; never expose it).
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace-with-your-service-role-key

# ---------- Market data (keyless, defaults are fine) ----------
DEXSCREENER_BASE_URL=https://api.dexscreener.com
GECKOTERMINAL_BASE_URL=https://api.geckoterminal.com/api/v2

# ---------- Wallet monitoring ----------
# auto    = use Helius webhooks if PUBLIC_WEBHOOK_URL and HELIUS_WEBHOOK_SECRET are set, else poll
# webhook = require webhooks
# polling = never use webhooks
WALLET_MONITOR_MODE=auto
# Public HTTPS base URL of this server (no path). Helius will POST to <url>/webhooks/helius
PUBLIC_WEBHOOK_URL=
# Shared secret Helius sends in the Authorization header (min 16 chars). Generate one, e.g.:
#   node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
HELIUS_WEBHOOK_SECRET=
# Optional: reuse an existing webhook (otherwise one is created and its ID is logged)
HELIUS_WEBHOOK_ID=
# Port for /health and the webhook receiver
HTTP_PORT=8080

# ---------- Job intervals ----------
WALLET_POLL_INTERVAL_SEC=120      # new-transaction check per tracked wallet (1 credit each)
MARKET_ALERT_INTERVAL_SEC=120     # price/volume/liquidity alerts + watchlist price history
WHALE_POLL_INTERVAL_SEC=600       # large-transaction monitor (10 credits per target per poll)
HOLDINGS_CHECK_INTERVAL_MIN=30    # significant holding changes (10 credits per wallet per check)
SNAPSHOT_INTERVAL_MIN=360         # portfolio snapshots of tracked wallets

# ---------- Limits ----------
USER_RATE_LIMIT_PER_MIN=20        # Telegram requests per user per minute
HTTP_TIMEOUT_MS=15000             # outbound API timeout
WALLET_HISTORY_MAX_PAGES=5        # ×1000 signatures scanned to find wallet age / tx count
MAX_TRACKED_WALLETS_PER_USER=25
MAX_ALERTS_PER_USER=50
